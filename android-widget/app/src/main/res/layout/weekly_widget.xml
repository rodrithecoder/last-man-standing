<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_background">
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Easy Party Kit · This Week" android:textSize="15sp"
      android:textColor="#F4DA96" android:textStyle="bold"/>
  <TextView android:id="@+id/counts" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Open Easy Party Kit to load this week" android:layout_marginTop="8dp"
      android:textColor="#FFFFFF" android:textSize="13sp"/>
  <TextView android:id="@+id/job1" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="" android:layout_marginTop="7dp"
      android:textColor="#E3EEDF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/job2" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="" android:layout_marginTop="3dp"
      android:textColor="#E3EEDF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/job3" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="" android:layout_marginTop="3dp"
      android:textColor="#E3EEDF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/collections" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Expected collections: —" android:layout_marginTop="10dp"
      android:textColor="#F4DA96" android:textStyle="bold" android:textSize="15sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:text="Not synchronized"
        android:textColor="#BBD3C2" android:textSize="10sp"/>
    <TextView android:id="@+id/new_booking" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="+ New Booking"
        android:textColor="#F4DA96" android:textSize="12sp" android:textStyle="bold"
        android:padding="6dp"/>
  </LinearLayout>
</LinearLayout>
